# ---- Database ----
DATABASE_URL=postgresql://hms:change_me@postgres:5432/hms
DATABASE_URL_TEST=postgresql://hms:change_me@postgres:5432/hms_test

# ---- Security ----
JWT_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=change_me_to_another_long_random_string
SESSION_TTL_MINUTES=480
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Reverse-proxy hops in front of the API (1 = nginx). Per-IP rate limits (a NAT'd property shares one public IP).
TRUST_PROXY_HOPS=1
RATE_LIMIT_API_PER_MINUTE=1200
RATE_LIMIT_LOGIN_PER_15MIN=100

# ---- Backend ----
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
STORAGE_PATH=./uploads
UPLOAD_MAX_SIZE=10485760
BACKUP_PATH=./backups

# ---- Frontend ----
NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://backend:4000

# ---- First-run seed (`npm run seed` / `npm run seed:prod`) ----
#   demo    = full demo hotel (Demo Hotel & Resort, 18 users with password Password123, rooms, outlets, menus, stock)
#   minimal = PRODUCTION: organisation + roles + chart of accounts + taxes + payment methods + workflows + ONE admin
#             user (ADMIN_PASSWORD, forced change at first login) — no demo data. The HOTEL_*/COMPANY_* values below
#             name your organisation (they are ignored in demo mode).
SEED_MODE=demo
# Only for SEED_MODE=minimal. Prefer passing it once at seed time instead of storing it here:
#   docker compose exec -e ADMIN_PASSWORD='...' backend npm run seed:prod
ADMIN_PASSWORD=
HOTEL_NAME=My Hotel
HOTEL_CODE=MAIN
COMPANY_NAME=My Hospitality Ltd
COMPANY_TAX_NUMBER=
HOTEL_ADDRESS=
HOTEL_CITY=Nairobi
HOTEL_COUNTRY=Kenya
HOTEL_PHONE=
HOTEL_EMAIL=
HOTEL_CURRENCY=KES
HOTEL_TIMEZONE=Africa/Nairobi
SERVICE_CHARGE_PERCENT=10

# ---- Defaults ----
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_LOCALE=en

# ---- Email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ---- Deployment (docker-compose) ----
POSTGRES_PASSWORD=change_me
# Host interface/port nginx is published on. Behind a Cloudflare Tunnel keep HTTP_BIND=127.0.0.1 (nothing
# reachable from outside); use 0.0.0.0 only when serving the LAN / terminating TLS on this host.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# docker-compose.prod.yml --profile tunnel : Cloudflare Tunnel token (public HTTPS without open ports)
CLOUDFLARE_TUNNEL_TOKEN=
# auto (QUIC, default) or http2 when the network blocks UDP 7844
CLOUDFLARE_TUNNEL_PROTOCOL=auto
# Production convenience: make plain `docker compose …` use the prod file and profiles (see docs/DEPLOYMENT.md)
#COMPOSE_FILE=docker-compose.prod.yml
#COMPOSE_PROFILES=tunnel,backup
# docker-compose.prod.yml --profile backup : nightly pg_dump schedule (cron syntax) and retention
BACKUP_CRON=15 2 * * *
BACKUP_KEEP_DAYS=14
